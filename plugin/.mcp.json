{
  "mcpServers": {
    "mail": {
      "command": "npx",
      "args": [
        "-y",
        "stalwart-mail-mcp@2.2.0"
      ],
      "env": {
        "STALWART_URL": "${user_config.server_url}",
        "STALWART_USER": "${user_config.email}",
        "STALWART_PASSWORD": "${user_config.password}",
        "MAIL_LANG": "${user_config.language}",
        "MAIL_ALLOW_SEND": "${user_config.allow_send}",
        "MAIL_OCR_PROVIDER": "${user_config.ocr_provider}",
        "MAIL_OCR_API_KEY": "${user_config.ocr_api_key}",
        "MAIL_OCR_MODEL": "${user_config.ocr_model}",
        "MAIL_OCR_BASE_URL": "${user_config.ocr_base_url}"
      }
    }
  }
}
